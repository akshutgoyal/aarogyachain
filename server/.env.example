PORT=5000
NODE_ENV=development

# --- Database (optional) -----------------------------------------------------
# MongoDB is a CACHE, never a source of truth. The API runs without it and
# rebuilds record metadata from chain logs; start it to get the fast index.
#
# Atlas:  mongodb+srv://<user>:<password>@<cluster>.xxxxx.mongodb.net/<dbname>?retryWrites=true&w=majority
# Local:  mongodb://localhost:27017/aarogyachain
#
# Two things that catch everyone out:
#   1. The database NAME goes in the path. Omit it and Mongo quietly uses `test`.
#   2. If the password contains @ : / ? # [ ] % it must be percent-encoded.
#
# Check it with:  npm run ping
DATABASE_URL=

# --- Chain (read-only) -------------------------------------------------------
# The server holds NO signing key. Every write is signed in the browser by the
# user's own wallet, so there is nothing here for an attacker to steal.
SEPOLIA_RPC_URL=https://ethereum-sepolia-rpc.publicnode.com
CONTRACT_ADDRESS=0x464e6963cE0D833193C83Fc8Bd081614B9344b03
# The block the contract was created in — Etherscan shows it on the creation tx.
# Setting this skips a ~24-call binary search for the first block of code.
# Omit it and the server finds the block itself.
CONTRACT_DEPLOY_BLOCK=11714309

# --- Gemini ------------------------------------------------------------------
# Server-side only. A key in the Vite bundle is public the moment the page loads.
GEMINI_API_KEY=
# 3.6-flash is the verified-working default on a free-tier key.
# 3.8-flash intermittently returns 503 "high demand".
# First fallback is gemini-3.1-pro-preview (exact string matters: `gemini-3.1-pro`
# alone is a 404). Note it has returned 429 with a 0-token/min free-tier limit
# before, so Flash fallbacks follow it — a busy Pro must not take the demo down.
GEMINI_MODEL=gemini-3.6-flash
GEMINI_MODEL_FALLBACKS=gemini-3.1-pro-preview,gemini-3.5-flash,gemini-3.5-flash-lite,gemini-3.1-flash-lite

# --- The AI's on-chain identity ----------------------------------------------
# Sending a record's CONTENT to a third-party model is a separate act from reading
# it, so it needs its own consent. Rather than invent a parallel permission system,
# the AI is registered as an ordinary VIEWER: the patient grants it a window with
# the same grantAccess() call a doctor uses, and the server checks it with the same
# viewRecord() call. The address holds no key — it never signs anything, it is only
# ever the subject of a consent grant.
AI_VIEWER_ADDRESS=0x000000000000000000000000000000000000A1A1

# --- Key sealing -------------------------------------------------------------
# 64 hex chars. Seals each record's content key at rest. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
MASTER_KEY=
